# a short name for the app, use - for spaces
NAME="dummy"

# a product name for the app, use - for spaces
PRODUCT_NAME="dummy-app"

# a version number, use #.#.# as format
VERSION="1.0.0"

# a short description
DESCRIPTION="An app for dumb things."

# author's name or company name
AUTHOR_NAME="Stephen Becklin"

# author's email or company email
AUTHOR_EMAIL="stephen.becklin@me.me"

# author's website or company website
AUTHOR_URL="me.me"

# URL to support page
HOMEPAGE="me.me/support"

#################################################################################################

# name of project for folder, use - or _ for spaces
PROJECT_NAME="dummy-app"

# path to directory holding template files
TEMPLATE_FILES_DIR="../templates"

#################################################################################################

# com.your_name.app_descriptor
APP_ID="com.stephen_becklin.dummy-app"

# name of executable file for Windows, use - for spaces
WINDOWS_EXECUTABLE_NAME="dummy"

# MUST MATCH THE CERTIFICATE'S NAME EXACTLY
AZURE_PUBLISHER_NAME="blah"

# the region pyou chose in Azure; likely https://eus.codesigning.azure.net/
AZURE_ENDPOINT="blah"

# your profile name
AZURE_PROFILE_NAME="blah"

# signing account's name, not that of the app registration
AZURE_ACCOUNT_NAME="blah"

# your name
MAINTAINER="Stephen Becklin"

# macOS code signing provided by Developer ID Application certificate hosted by the keychain
# if not using keychain, need:
# CSC_LINK=/path/to/cert.p12
# CSC_KEY_PASSWORD=your-p12-password
# macOS notarization
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=ABCDE12345

# Windows Azure signing
AZURE_TENANT_ID=...
AZURE_CLIENT_ID=...
AZURE_CLIENT_SECRET=...
